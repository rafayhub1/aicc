rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function ownsNew() {
      return signedIn() && request.resource.data.user_id == request.auth.uid;
    }

    function ownsExisting() {
      return signedIn() && resource.data.user_id == request.auth.uid;
    }

    function keepsOwner() {
      return request.resource.data.user_id == resource.data.user_id;
    }

    match /users/{userId} {
      allow read: if (signedIn() && request.auth.uid == userId) || isAdmin();
      allow write: if signedIn() && request.auth.uid == userId;
    }

    match /activity_events/{eventId} {
      allow create: if ownsNew();
      allow read: if ownsExisting() || isAdmin();
      allow delete: if ownsExisting() || isAdmin();
      allow update: if ownsExisting() && keepsOwner();
    }

    match /chat_sessions/{sessionId} {
      allow create: if ownsNew();
      allow read: if ownsExisting() || isAdmin();
      allow delete: if ownsExisting() || isAdmin();
      allow update: if ownsExisting() && keepsOwner();
    }

    match /chat_messages/{messageId} {
      allow create: if ownsNew();
      allow read: if ownsExisting() || isAdmin();
      allow delete: if ownsExisting() || isAdmin();
      allow update: if ownsExisting() && keepsOwner();
    }

    match /faculty/{facultyId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /places/{placeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /indoor_maps/{areaId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
